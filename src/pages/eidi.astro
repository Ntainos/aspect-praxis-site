---
import Layout from '../layouts/Layout.astro';
import InternalIntro from '../components/InternalIntro.astro';
import ApplicationClosing from '../components/ApplicationClosing.astro';
import Card from '../components/Card.astro';
import Icon from '../components/home/Icon.astro';
import groups from '../data/categories.json';
import '../styles/internal.css';
---
<Layout title="23 είδη πράξεων · Praxis" description="23 είδη πράξεων: αγοραπωλησία ακινήτου, προσύμφωνο, εξόφληση τιμήματος, γονική παροχή, δωρεά, αποδοχή κληρονομιάς, πληρεξούσιο."><div class="internal-page categories-page"><InternalIntro label="Είδη πράξεων" title="23 είδη πράξεων." description="Για κάθε είδος, το Praxis συντάσσει σχέδιο σε Word με τον ίδιο τρόπο: με εγκεκριμένες διατυπώσεις και με τη βοήθεια τεχνητής νοημοσύνης σε όλη τη διαδρομή, από την κλίση ως τον έλεγχο της πράξης."/><section class="container category-grid">{groups.map(group=><section class="deed-category"><h2>{group.title}<span>{group.count}</span></h2><ol>{group.items.map(([number,label])=><li><span>{number}</span>{label}</li>)}</ol></section>)}<Card class="development-card"><h2>Νέα είδη πράξεων, ήδη υπό ανάπτυξη</h2><p>Η βιβλιοθήκη μεγαλώνει διαρκώς, με νέα είδη πράξεων και νέες δυνατότητες. Όλο και λιγότερη πληκτρολόγηση, όλο και περισσότερος χρόνος για τον έλεγχο.</p><p>Ποια είδη συντάσσετε συχνότερα; Γράψτε τα στο μήνυμα της αίτησης.</p><a class="internal-link" href="/aitisi">Στην αίτηση <Icon/></a></Card></section><ApplicationClosing/></div></Layout>
