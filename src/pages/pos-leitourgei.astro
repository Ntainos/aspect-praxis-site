---
import Layout from '../layouts/Layout.astro';
import InternalIntro from '../components/InternalIntro.astro';
import ApplicationClosing from '../components/ApplicationClosing.astro';
import Illustration from '../components/workflow/Illustration.astro';
import Card from '../components/Card.astro';
import Icon from '../components/home/Icon.astro';
import DetailIcon from '../components/workflow/DetailIcon.astro';
import copy from '../data/workflow.json';
import '../styles/internal.css';
const title='Από τη φόρμα στο σχέδιο σε Word.';
const descriptions=[copy['Συμπληρώνετε τη φόρμα'],copy['Το Praxis συντάσσει, με τεχνητή νοημοσύνη'],copy['Ελέγχετε και παίρνετε το .docx']];
const titles=['Συμπληρώνετε τη φόρμα','Το Praxis συντάσσει, με τεχνητή νοημοσύνη','Ελέγχετε και παίρνετε το .docx'];
const subheads=[['Τα στοιχεία του γραφείου σας είναι κλειδωμένα'],['Γένος, αριθμός και πτώσεις, αυτόματα','Προτάσεις παραγράφων με τεχνητή νοημοσύνη'],['Έλεγχος της πράξης με τεχνητή νοημοσύνη','«Ρωτήστε το Praxis»','Νέο σχέδιο μετά από διόρθωση']];
---
<Layout title={title}><div class="internal-page workflow-page"><InternalIntro label="Πώς λειτουργεί" title={title} description={copy[title]}/><div class="container workflow-content">{titles.map((title,i)=><section class="workflow-step"><div class="workflow-columns"><div><span class="workflow-number">{i+1}</span><h2>{title}</h2><p class="step-intro">{descriptions[i]}</p>{subheads[i].map((heading,j)=><div class="workflow-detail"><DetailIcon name={i===2?['document','chat','refresh'][j]:i===1?['cases','ai'][j]:'lock'}/><div><h3>{heading}</h3><p>{copy[heading]}</p>{i===1&&j===0&&<><p>Για τοπωνύμια και μικρά ονόματα που δεν υπάρχουν στους πίνακες του Praxis, η τεχνητή νοημοσύνη προτείνει την κλίση και τη διορθώνετε με ένα κλικ. Στέλνεται μόνο αυτή η λέξη, χωριστά, χωρίς κανένα άλλο στοιχείο της πράξης.</p><a class="internal-link" href="/dedomena">Πώς προστατεύουμε τα δεδομένα <Icon/></a></>}</div></div>)}</div><Illustration step={i+1}/></div>{i===1&&<div class="needs-grid"><div class="needs-intro"><h3>Σας δείχνει ακριβώς τι χρειάζεται</h3><p>{copy['Σας δείχνει ακριβώς τι χρειάζεται']}</p></div><div class="needs-cards"><Card><h3>Ένα στοιχείο της πράξης</h3><p>Το συμπληρώνετε στη φόρμα και βγάζετε ξανά το σχέδιο.</p></Card><Card><h3>Μια διατύπωση για τη συγκεκριμένη περίπτωση</h3><p>Το Praxis προτείνει παράγραφο με τεχνητή νοημοσύνη, για έγκριση· ή γράφετε το σημείο εσείς στο Word.</p></Card></div></div>}</section>)}<section class="workflow-responsibility"><h2>Η τεχνητή νοημοσύνη προτείνει. Η τελική κρίση και η ευθύνη μένουν στον συμβολαιογράφο.</h2><p>Το Praxis είναι εργαλείο υποστήριξης σύνταξης και δεν υποκαθιστά τον συμβολαιογράφο.</p><a class="internal-link" href="/eidi">Τα 23 είδη πράξεων <Icon/></a></section></div><ApplicationClosing/></div></Layout>
