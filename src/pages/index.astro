---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import ApplicationClosing from '../components/ApplicationClosing.astro';
import ProductIllustration from '../components/home/ProductIllustration.astro';
import DataDiagram from '../components/home/DataDiagram.astro';
import Icon from '../components/home/Icon.astro';
import data from '../data/home.json';
import '../styles/home.css';
const steps = [
 ['Συμπληρώνετε','Τα στοιχεία της πράξης, σε φόρμα με ενότητες.'],
 ['Το Praxis συντάσσει','Με εγκεκριμένες διατυπώσεις και αυτόματη κλίση. Για ό,τι δεν καλύπτει η βιβλιοθήκη, η τεχνητή νοημοσύνη προτείνει παράγραφο, σημασμένη για έγκριση.'],
 ['Ελέγχετε και παίρνετε το .docx','Εγκρίνετε τις προτάσεις μία-μία, ρωτάτε το Praxis για την πράξη, και παίρνετε το σχέδιο σε .docx για το Word.']
];
---
<Layout title="Praxis · Συμπληρώνετε μια φόρμα. Παίρνετε σχέδιο πράξης σε Word.">
<div class="homepage">
<section class="home-hero"><div class="container"><div class="hero-tags"><span>Με τεχνητή νοημοσύνη</span><span>Για συμβολαιογραφικά γραφεία</span></div><h1>Συμπληρώνετε μια φόρμα.<br class="desktop-only"/> Παίρνετε σχέδιο πράξης σε Word.</h1><p class="hero-intro">Το Praxis συντάσσει σχέδιο συμβολαιογραφικής πράξης με τη βοήθεια τεχνητής νοημοσύνης, από τα στοιχεία που δίνετε και διατυπώσεις εγκεκριμένες από συμβολαιογράφο. Το .docx το ελέγχετε και το επεξεργάζεστε στο Word.</p><div class="home-actions"><Button href="/aitisi">Κάντε αίτηση <Icon /></Button><Button href="/pos-leitourgei" variant="secondary">Πώς λειτουργεί</Button></div><p class="responsibility"><strong>Εργαλείο υποστήριξης σύνταξης.</strong> Η ευθύνη και η τελική κρίση μένουν στον συμβολαιογράφο.</p><ProductIllustration /></div></section>
<section class="home-section home-features"><div class="container"><p class="section-label">Με μια ματιά</p><h2>Πώς δουλεύει μαζί σας.</h2><div class="features-grid">{[0,1].map(group=><Card><h3><Icon name={group?'ai':'check'}/>{group?'Τεχνητή νοημοσύνη σε όλη τη διαδρομή':'Γράφει όπως ένα συμβολαιογραφικό γραφείο'}</h3><ul>{data.features.slice(group*4,group*4+4).map(([title,description])=><li><strong>{title}</strong><p>{description}</p></li>)}</ul></Card>)}</div></div></section>
<section class="home-section home-steps"><div class="container"><p class="section-label">Πώς λειτουργεί</p><h2>Από τη φόρμα στο<br/> Word, σε τρία βήματα.</h2><div class="steps-grid">{steps.map(([title,description],i)=><article><span class="step-number">{i+1}</span><div><h3>{title}</h3><p>{description}</p><div class="step-illustration" aria-hidden="true">{i===0?<><p>Πωλήτρια</p><div class="fake-field">Μαρία Κωνσταντίνου</div><p>Τόπος</p><div class="fake-field">Λάρισα</div><p>Συμβολαιογράφος · έδρα</p><div class="fake-field muted">[●] · Λάρισα</div></>:i===1?<><p><Icon name="check"/> Εγκεκριμένη διατύπωση από τη βιβλιοθήκη του Praxis</p><p><Icon name="check"/> Γένος και πτώσεις<br/> «η πωλήτρια», «στη Λάρισα»</p><p><Icon name="ai"/> Πρόταση τεχνητής νοημοσύνης για τον ειδικό όρο «[●]», για έγκριση</p></>:<><span class="ai-chip">Έλεγχος με τεχνητή νοημοσύνη</span><div class="mini-document"><p>Σχέδιο_αγοραπωλησίας.docx</p><div class="skeleton"></div><p>Για επεξεργασία στο Word <span>Λήψη .docx</span></p></div></>}</div></div></article>)}</div><div class="home-actions"><Button href="/aitisi">Κάντε αίτηση <Icon /></Button><a class="text-link" href="/pos-leitourgei">Αναλυτικά, πώς λειτουργεί <Icon /></a></div></div></section>
<section class="home-section home-types"><div class="container types-grid"><div><h2><span class="big-number">23</span> είδη πράξεων.</h2><p>Νέα είδη πράξεων είναι ήδη υπό ανάπτυξη, και η βιβλιοθήκη μεγαλώνει διαρκώς. Όλο και λιγότερη πληκτρολόγηση, όλο και περισσότερος χρόνος για τον έλεγχο.</p><a class="text-link types-desktop-link" href="/eidi">Όλα τα 23 είδη, ανά κατηγορία <Icon /></a></div><ol class="deed-types">{data.types.map(([number,title])=><li><span>{number}</span>{title}</li>)}</ol><a class="text-link types-mobile-link" href="/eidi">Όλα τα 23 είδη, ανά κατηγορία <Icon /></a></div></section>
<section class="home-section home-security dark"><div class="container"><p class="section-label">Ασφάλεια και δεδομένα</p><h2>Πώς προστατεύουμε τα<br class="desktop-only"/> δεδομένα των πελατών σας.</h2><p class="security-intro">Δεδομένα σε διακομιστές εντός ΕΕ. Στην τεχνητή νοημοσύνη πηγαίνουν μόνο ψευδώνυμα. Όλα όσα περιγράφουμε εδώ λειτουργούν ήδη.</p><DataDiagram /><ul class="security-points">{data.security.map(([title,description],i)=><li><Icon name={['eye','shield','cookie','database','download','document'][i]} /><div><strong>{title}</strong><p>{description}</p></div></li>)}</ul><a class="text-link" href="/dedomena">Ασφάλεια και δεδομένα, αναλυτικά <Icon /></a></div></section>
<section class="home-section home-prices"><div class="container prices-grid"><div><p class="section-label">Τιμές</p><h2>Μηνιαία συνδρομή<br/> ανά πακέτο.</h2><p class="lead">Κάθε πακέτο έχει ορισμένο αριθμό πράξεων τον μήνα και μέγιστο αριθμό χρηστών. Πληρωμή με κάρτα.</p><p class="billing-note"><Icon name="document"/> Μια πράξη μετρά μόνο όταν βγει .docx ή κείμενο. Όσο το Praxis σας δείχνει τι χρειάζεται ακόμη, δεν μετρά.</p><a class="text-link" href="/times">Τιμές και πακέτα <Icon /></a></div><div class="price-example"><Card><strong>Πακέτο [●]</strong><p class="price-number">[●] € <small>/ μήνα</small></p><p>Πράξεις τον μήνα <strong>[●]</strong></p><p>Χρήστες έως <strong>[●]</strong></p></Card><small>Ονόματα και ποσά των πακέτων: [●].</small></div></div></section>
<ApplicationClosing />
</div>
</Layout>
